\par HRESULT SpeakString(char *szSpeak)
\par \{
\par     HRESULT hRes;
\par 
\par     if( *szSpeak == NULL )
\par         return 0;
\par 
\par     // Put the text in the playback buffer.
\par     hRes = gpIVTxt-Speak(szSpeak,
\par         VTXTST_QUESTION | VTXTSP_NORMAL, NULL);
\par 
\par     return hRes;
\par \}\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cs82\f2\cf0 \row }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }
