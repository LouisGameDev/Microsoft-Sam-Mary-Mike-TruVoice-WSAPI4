\par BOOL BeginOLE()
\par \{
\par     HRESULT hRes;
\par     PISRFind pISRFind = NULL;
\par     // Initialize OLE.
\par     if (FAILED(CoInitialize(NULL)))
\par         return FALSE;
\par     // Create the audio-source object and retrieve the address of the
\par     // object's IAudioMultiMediaDevice interface. By default, the object
\par     // uses the WAVE_MAPPER device.
\par     if (CoCreateInstance(CLSID_MMAudioSource, NULL, CLSCTX_ALL,
\par             IID_IAudioMultiMediaDevice, (LPVOID *) &g_pIAMMD) != S_OK)
\par         return FALSE;
\par     // Create a speech recognition sharing object and retrieve the
\par     // address of the object's IEnumSRShare interface.
\par     CoCreateInstance(CLSID_SRShare, NULL, CLSCTX_ALL,IID_IEnumSRShare,
\par         (LPVOID *) &g_pIEnumSRShare);
\par     // Create a speech recognition enumerator and retrieve the address
\par     // of the enumerator's ISRFind interface.
\par     if (CoCreateInstance(CLSID_SREnumerator, NULL, CLSCTX_ALL,
\par             IID_ISRFind, (LPVOID *) &g_pSRFind) != S_OK)
\par         return FALSE;
\par     // Call an application-defined function that uses the speech-
\par     // recognition sharing object and enumerator to find and select a
\par     // suitable speech recognition engine.
\par     hRes = FindSuitableEngine(pISRFind);
\par     pISRFind-Release();
\par     if (hRes != NOERROR) return FALSE;
\par     // Create the grammar notification interface based on an
\par     // application-defined CISRGramNotifySink class.
\par     if ((g_pGramNotifySink = new CISRGramNotifySink) == NULL)
\par         return FALSE;
\par     // Call an application-defined function that reads grammar data from
\par     // a file and then loads the grammar.
\par     if (!InitializeGrammar(g_pISRCentral, g_szGramFile))
\par         return FALSE;
\par     // Activate the grammar.
\par     if ((hRes = g_pISRGramCommon-Activate(g_hWndMain, FALSE, NULL))
\par             != NOERROR)
\par         return FALSE;
\par 
\par     return TRUE;
\par \}}{\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cf0 \row }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }
\outlinelevel1\adjustright \fs40\kerning28\cgrid {\cf1 {\*\bkmkstart Finding}Finding a Suitable Engine and Audio Source }{{\*\bkmkend Finding}
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {
You use the speech recognition sharing object and the speech recognition enumerator to find and select an engine and audio-source pair that meets the needs of your a
pplication. Because sharing an engine and audio source is more efficient in terms of system resources than using a private pair, you should try to find and use a shared pair before creating a private pair. You should follow these steps to find and select 
an engine and audio source:
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard\plain \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright \fs20\cgrid 
{Use the enumeration functions of the sharing object's }{\b IEnumSRShare}{ interface to search for a suitable shared engine and audio-source pair. If the sharing object finds a suitable pair, use the }{\b IEnumSRShare}{::}{\b Share}{ member function t
o use the shared pair for speech recognition. 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {
If the sharing object doesn't find a suitable pair, use the speech recognition enumerator's }{\b ISRFind}{ or }{\b ISREnum}{ interfaces to find a suitable engine, and then try to create a shared engine and audio-source pair by calling the }{\b 
IEnumSRShare}{::}{\b New}{ member function. 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {If the }{\b 
IEnumSRShare}{::}{\b New}{ member function fails, create a private engine and audio-source pair by calling the }{\b ISRFind}{::}{\b Select}{ or }{\b ISREnum}{::}{\b Select}{ member function. 
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The following example demonstrates how to 
find and select a suitable engine and audio-source pair. In the example, a "suitable engine" is one that supports WAVE_MAPPER as the audio-input device, recognizes English speech, and supports context-free grammars. 
\par The function uses a speech recognition enumerator to find a speech recognition engine that supports context-free grammars and recognizes English speech. It returns a result code and }{\i pISRFind}{ -- address of the }{\b ISRFind}{
 interface. The function uses the following global variables:
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard\plain \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright \fs20\cgrid 
{\i g_srModeInfo}{ -- }{\b SRMODEINFO}{ structure that contains information about the current speech recognition mode 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i g_qwInstID}{
 -- instance identifier of the shared engine/audio-source pair 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i 
g_pIEnumSRShare}{ -- address of the }{\b IEnumSRShare}{ interface 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i g_pISRCentral}
{ -- address of the }{\b ISRCentral}{ interface 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i g_pIAMMD}{
 -- address of the IAudioMultiMediaDevice interface 
\par }\pard\plain \s83\li360\ri360\nowidctlpar\intbl\tx0\tx959\tx1918\tx2877\tx3836\tx4795\tx5754\tx6713\tx7672\tx8631{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f2\fs20 {\field{\*\fldinst {PRIVATE}{{\*\datafield 
020203001a0200000000017e0000000000000000000001000000000000000000cf1f010000001a01000001000000000000000000000000000000010000000000000000000000000000000000000000000000000000011c5404e71c54041b010000051d54041c010000cf1f0000000000008c00000000000000000000000000
00000000000000000000000000000000}}}{\fldrslt }}{\cs82 
\par HRESULT FindSuitableEngine(PISRFind pISRFind)
\par \{
\par     SRMODEINFO srmiFound;
\par     SRSHARE srShare;
\par     HRESULT hRes;
\par     ULONG uNum;
\par     GUID guid;
\par     DWORD dwNumFound;
\par     PISREnum pISREnum;
\par     // Erase the contents of the global SRMODEINFO structure.
\par     ZeroMemory(&g_srModeInfo, sizeof(g_srModeInfo));
\par     // Define the mode to look for by filling the relevant members of
\par     // the global SRMODEINFO structure.
\par     g_srModeInfo.language.LanguageID =
\par         MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US);
\par     g_srModeInfo.dwGrammars = SRGRAM_CFG;
\par     // Use the speech recognition sharing object to find a suitable
\par     // shared engine/audio-source pair.
\par     if (g_pIEnumSRShare != NULL) \{
\par         while (TRUE) \{
\par             ZeroMemory(&srShare, sizeof(srShare));
\par             hRes = g_pIEnumSRShare-Next(1, &srShare, &uNum);
\par             if ((hRes == S_FALSE) || (FAILED(hRes)))
\par                 break;
\par             if ((srShare.dwDeviceID == WAVE_MAPPER) &&
\par                     (srShare.srModeInfo.language.LanguageID ==
\par                         g_srModeInfo.language.LanguageID) &&
\par                     (srShare.srModeInfo.dwGrammars ==
\par                         g_srModeInfo.dwGrammars))
\par                 break;
\par         \}
\par 
\par         // See if a shared mode was found by using memcmp (a C run-time
\par         // function) to check if the GUID is zero. If the GUID is valid,
\par         // share the engine/audio-source pair.
\par         ZeroMemory(&guid, sizeof(guid));
\par         if (memcmp(&srShare.srModeInfo.gModeID, &guid,
\par                  sizeof(GUID)) != 0) \{
\par             hRes = g_pIEnumSRShare-Share(srShare.qwInstanceID,
\par                    (pISRCentral *) &g_pISRCentral);
\par                 if (hRes == NOERROR)
\par                     return NOERROR;
\par         \}
\par     \}
\par     // No shared mode found. Use an engine enumerator to find a suitable
\par     // engine.
\par     ZeroMemory(&srmiFound, sizeof(srmiFound));
\par     if (hRes = pISRFind-QueryInterface(IID_ISREnum,
\par             (LPVOID *) &pISREnum) != NOERROR)
\par         return hRes;
\par     while (hRes = pISREnum-Next(1, &srmiFound, &dwNumFound) == NOERROR)
\par         if ((srmiFound.language.LanguageID ==
\par             g_srModeInfo.language.LanguageID)
\par             && (srmiFound.dwGrammars == g_srModeInfo.dwGrammars))
\par             break;
\par 
\par     pISREnum-Release();    // release enumerator
\par     // See if the enumerator found a suitable engine.
\par     ZeroMemory(&guid, sizeof(guid));
\par     if (memcmp(&srmiFound.gModeID, &guid, sizeof(GUID)) == 0)
\par         return -1;          // no suitable engine found
\par     // The engine is suitable. Try to create an engine/audio-source pair
\par     // that can be shared.
\par     if (g_pIEnumSRShare != NULL) \{
\par         hRes = g_pIEnumSRShare-New(WAVE_MAPPER, srmiFound.gModeID,
\par            (pISRCentral *) &g_pISRCentral, &g_qwInstID);
\par         if (hRes == NOERROR)
\par             return NOERROR; // engine successfully shared
\par     \}
\par     // Couldn't create a shared pair. Try to create a private
\par     // engine/audio-source pair.
\par     hRes = pISRFind-Select(srmiFound.gModeID, &g_pISRCentral,
\par         (LPUNKNOWN) g_pIAMMD);
\par     if (hRes == NOERROR)
\par         return NOERROR;     // private mode successfully created
\par     return -1; // no suitable engine
\par \}}{\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cf0 \row }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }
\outlinelevel1\adjustright \fs40\kerning28\cgrid {\cf1 {\*\bkmkstart Loading}Loading a Grammar}{{\*\bkmkend Loading}
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {A grammar provides a speech recognit
ion engine with the words and rules that determine what the engine can recognize. Before an engine can use a grammar, you must create and load a grammar object by calling the }{\b ISRCentral}{::}{\b GrammarLoad}{
 member function. The function's arguments include an }{\b SDATA}{ structure that specifies the address and size of the grammar's data, and the address of the }{\b ISRGramNotifySink}{
 interface that the engine uses to notify the application of recognition events. The }{\b GrammarLoad}{ member function returns the address of the grammar object's }{\b IUnknown}{ interface. The application can use }{\b IUnknown}{
 to retrieve the addresses of other interfaces provided by the grammar object, including }{\b ISRGramCommon}{ and }{\b ISRGramCFG}{. 
\par The following example shows how to load a grammar, create a grammar object, and obtain the addresses of the grammar object's }{\b ISRGramCommon}{ and }{\b ISRGramCFG}{ interfaces. The example includes a function called }{\b GrammarReadFile}{
 that creates a memory object, reads grammar data from a file into the object, and fills an }{\b SDATA}{ structure with the address and size of the object. 
\par The function loads a context-free grammar and obtains the addresses of interfaces supported by the grammar object. It returns TRUE if successful, or FALSE otherwise. }{\i pISRCentral}{ is the address of the }{\b ISRCentral}{ interface. }{\i pszFileName}{
 is the name of the grammar file. The function uses the following global variables:
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard\plain \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright \fs20\cgrid 
{\i g_pGramNotifySink}{ -- address of the application's }{\b ISRGramNotifySink}{ interface 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i 
g_pISRGramCommon}{ -- address of the }{\b ISRGramCommon}{ interface 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i g_pISRGramCFG}
{ -- address of the }{\b ISRGramCFG}{ interface 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {\i 
g_pISRGramDictation}{ -- address of the }{\b ISRGramDictation}{ interface 
\par }\pard\plain \s83\li360\ri360\nowidctlpar\intbl\tx0\tx959\tx1918\tx2877\tx3836\tx4795\tx5754\tx6713\tx7672\tx8631{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f2\fs20 {\field{\*\fldinst {PRIVATE}{{\*\datafield 
020203001a0200000000017e0000000000000000000001000000000000000000cf1f010000001a02000001000000000000000000000000000000010000000000000000000000000000000000000000000000000000cab65404a1b754041b020000bfb754041c020000cf1f0000000000008c00000000000000000000000000
00000000000000000000000000000000}}}{\fldrslt }}{\cs82 
\par BOOL InitializeGrammar(pISRCentral pISRCentral, LPSTR pszFileName)
\par \{
\par     SDATA dGramData;
\par     HGLOBAL hgbl;
\par     HRESULT hRes;
\par     LPUNKNOWN lpUnk;
\par 
\par     // Call an application-defined function that reads the contents of
\par     // the specified grammar file into a global memory object.
\par     if (!GrammarReadFile(pszFileName, &dGramData, &hgbl))
\par         return FALSE;
\par     // Load the grammar and create a grammar object.
\par     hRes = pISRCentral-GrammarLoad(SRGRMFMT_CFG, dGramData,
\par         (PVOID)g_pGramNotifySink, IID_ISRGramNotifySink, &lpUnk);
\par     // Unlock and free the global memory object.
\par     GlobalUnlock(hgbl);
\par     GlobalFree(hgbl);
\par         if (hRes != NOERROR) \{
\par         HandleError(hRes);
\par         return FALSE;
\par     \}
\par     // Get the address of the ISRGramCommon interface.
\par     hRes = lpUnk-QueryInterface(IID_ISRGramCommon,
\par         (void**) &g_pISRGramCommon);
\par     if (hRes != NOERROR) \{
\par         HandleError(hRes);
\par         lpUnk-Release();
\par         return FALSE;
\par     \}
\par 
\par     // Get the address of the ISRGramCFG interface.
\par     hRes = lpUnk-QueryInterface(IID_ISRGramCFG,
\par         (void**) &g_pISRGramCFG);
\par     if (hRes != NOERROR) \{
\par         HandleError(hRes);
\par         lpUnk-Release();
\par         return FALSE;
\par     \}
\par     // Get the address of the ISRGramDictation interface.
\par     hRes = lpUnk-QueryInterface(IID_ISRGramDictation,
\par         (void**) &g_pISRGramDict);
\par     lpUnk-Release();
\par     return TRUE;
\par \}}{\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cf0 \row }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {
The following function (used above) reads the contents of a grammar file into a global memory object and returns TRUE if successful, or FALSE otherwise. }{\i pszFileName}{ is the name of the grammar file. }{\i pData}{
 is the address of a structure that receives the size and address of the grammar data. }{\i phgbl}{ is the address of a variable that receives the handle of the memory object
\par }\pard\plain \s83\li360\ri360\nowidctlpar\intbl\tx0\tx959\tx1918\tx2877\tx3836\tx4795\tx5754\tx6713\tx7672\tx8631{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f2\fs20 {\field{\*\fldinst {PRIVATE}{{\*\datafield 
020203001a0200000000017e0000000000000000000001000000000000000000cf1f010000001a03000001000000000000000000000000000000010000000000000000000000000000000000000000000000000000c9bc5404ecbc54041b0300000abd54041c030000cf1f0000000000008c00000000000000000000000000
00000000000000000000000000000000}}}{\fldrslt }}{\cs82 
\par BOOL GrammarReadFile(LPSTR pszFileName, PSDATA pData, HGLOBAL *phgbl)
\par \{
\par     HANDLE hf;
\par     DWORD dwBytesRead;
\par     // Open the grammar file.
\par     hf = CreateFile(pszFileName, GENERIC_READ, 0, NULL, OPEN_EXISTING,
\par             FILE_ATTRIBUTE_NORMAL, NULL);
\par     if (hf == NULL)
\par         return FALSE;
\par     // Retrieve the file size and allocate a global memory object
\par     // to contain the file's contents.
\par     pData-dwSize = GetFileSize(hf, NULL);
\par     *phgbl = GlobalAlloc(GMEM_ZEROINIT, pData-dwSize);
\par     pData-pData = GlobalLock(*phgbl);
\par     if (!pData-pData) \{
\par         CloseHandle(hf);
\par         return FALSE;
\par     \}
\par     // Read the contents of the file into memory, filling the SDATA
\par     // structure in the process.
\par     ReadFile(hf, pData-pData, pData-dwSize, &dwBytesRead, NULL);
\par     CloseHandle(hf);
\par     return TRUE;
\par \}}{\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cf0 \row }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }
\outlinelevel1\adjustright \fs40\kerning28\cgrid {\cf1 {\*\bkmkstart Processing}Processing Recognition Notifications}{{\*\bkmkend Processing}
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The speech recognition engine object calls an application's }{\b ISRGramNotifySink}{
 interface to inform the application of recognition events so that the application can respond to them. To receive notifications, the application must create a COM object that supports the }{\b ISRGramNotifySink}{ interface, and it must pass the
 address of the interface to the engine object when calling the }{\b ISRCentral}{::}{\b GrammarLoad}{ member function. 
\par The }{\b ISRGramNotifySink}{ interface consists of a set of member functions that correspond to recognition events. When an event occurs, the engine object calls the member function that corresponds to the event. 
\par The following example shows how to define an object class that implements the }{\b ISRGramNotifySink}{ interface:
\par }\pard\plain \s83\li360\ri360\nowidctlpar\intbl\tx0\tx959\tx1918\tx2877\tx3836\tx4795\tx5754\tx6713\tx7672\tx8631{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f2\fs20 {\field{\*\fldinst {PRIVATE}{{\*\datafield 
020203001a0200000000017e0000000000000000000001000000000000000000cf1f010000001a0400000100000000000000000000000000000001000000000000000000000000000000000000000000000000000094605504b76055041b040000d56055041c040000cf1f0000000000008c00000000000000000000000000
00000000000000000000000000000000}}}{\fldrslt }}{\cs82 
\par class CISRGramNotifySink : public ISRGramNotifySink \{
\par     public:
\par         CISRGramNotifySink(void);
\par         ~CISRGramNotifySink(void);
\par         // IUnknown members that delegate to m_punkOuter
\par         // Non-delegating object IUnknown
\par         STDMETHODIMP         QueryInterface (REFIID, LPVOID FAR *);
\par         STDMETHODIMP_(ULONG) AddRef();
\par         STDMETHODIMP_(ULONG) Release();
\par         // ISRNotifySink
\par         STDMETHODIMP BookMark         (DWORD);
\par         STDMETHODIMP Paused           ();
\par         STDMETHODIMP PhraseFinish     (DWORD, QWORD, QWORD, PSRPHRASE,
\par             LPUNKNOWN);
\par         STDMETHODIMP PhraseHypothesis (DWORD, QWORD, QWORD, PSRPHRASE,
\par             LPUNKNOWN);
\par         STDMETHODIMP PhraseStart      (QWORD);
\par         STDMETHODIMP ReEvaluate       (LPUNKNOWN);
\par         STDMETHODIMP Training         (DWORD);
\par         STDMETHODIMP UnArchive        (LPUNKNOWN);
\par         CISRGrammarObject *m_pGramObj;   // address of grammar object
\par protected:
\par         DWORD m_dwRefCnt;
\par \};}{\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cf0 \row }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {
The following example shows a simple implementation of the }{\b ISRGramNotifySink}{::}{\b PhraseFinish}{ member function. The engine object calls }{\b PhraseFinish}{
 when the speaker has finished a phrase and the engine has recognized the words that were spoken. The member function receives the address of an }{\b SRPHRASE}{ structure that includes one }{\b SRWORD}{ structure for each recognized word i
n the phrase. The example parses the }{\b SRPHRASE}{ structure, writes the words from the phrase into a buffer, and then causes a WM_PAINT message to be sent to a window that draws the contents of the buffer. 
\par }\pard\plain \s83\li360\ri360\nowidctlpar\intbl\tx0\tx959\tx1918\tx2877\tx3836\tx4795\tx5754\tx6713\tx7672\tx8631{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f2\fs20 {\field{\*\fldinst {PRIVATE}{{\*\datafield 
020203001a0200000000017e0000000000000000000001000000000000000000cf1f010000001a0500000100000000000000000000000000000001000000000000000000000000000000000000000000000000000090645504b36455041b050000d16455041c050000cf1f0000000000008c00000000000000000000000000
00000000000000000000000000000000}}}{\fldrslt }}{\cs82 
\par STDMETHODIMP CISRGramNotifySink::PhraseFinish(DWORD dwFlags,
\par     QWORD qTimeStampBegin, QWORD qTimeStampEnd, PSRPHRASE pSRPhrase,
\par \{
\par     DWORD dwCnt;     // count of SRPHRASE bytes processed
\par     SRWORD *psrWord;
\par     PBYTE pb;
\par     // Check the flags to determine whether to process the phrase.
\par     if (!((dwFlags & ISRNOTEFIN_RECOGNIZED) &&
\par         (dwFlags & ISRNOTEFIN_THISGRAMMAR)))
\par         return -1;
\par     // Initialize variables for processing the SRPHRASE structure.
\par     dwCnt = sizeof(pSRPhrase-dwSize); // account for size of dwSize
\par     psrWord = (SRWORD *) pSRPhrase-abWords; // point to first SRWORD
\par     pb = (PBYTE) psrWord; // initialize index pointer
\par     g_szPhrase[0] = '\\0'; // makes lstrcat work properly
\par     // Process the SRPHRASE structure, stopping the entire contents
\par     // have been processed.
\par     while (dwCnt  pSRPhrase-dwSize) \{
\par         // Copy word to buffer, followed by a space to separate words.
\par         lstrcat(g_szPhrase, (LPSTR) psrWord-szWord);
\par         lstrcat(g_szPhrase, " ");
\par         dwCnt += psrWord-dwSize; // add size of SRWORD to index
\par         pb += psrWord-dwSize;    // move index pointer to next SRWORD
\par         psrWord = (PSRWORD) pb;   // point to next SRWORD
\par     \}
\par     // Cause a WM_PAINT so that the phrase is drawn in the window.
\par     InvalidateRect(g_hWndSR, NULL, TRUE);
\par     UpdateWindow(g_hWndSR);
\par     return NOERROR;
\par \}}{\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cf0 \row }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {
\par \page }{\cs80\v\cf6 <!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">}{\fs28 DirectSpeechRecognition API }{
\par }\pard\plain \s1\li-360\sb120\sa120\sl-560\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel0\adjustright \fs52\kerning28\cgrid {\cf1 COM Objects}{
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Speech-recognition objects provide detailed control of speech recognition. Together these objects serve as a recognition 
layer for an application, allowing it to use any of the speech recognition engines available in the system and to recognize input from multimedia wave-in devices or other audio sources. This section describes these objects and lists the interfaces they su
pport.
\par Implementing DirectSpeechRecognition in an application involves the use of six different objects:
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard\plain \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright \fs20\cgrid 
{Engine object 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {
Engine enumerator 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {Grammar object 

\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {
Speech recognition enumerator 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {
Speech recognition results object 
\par {\pntext\pard\plain\s65 \f3\fs20\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s65\fi-300\li300\sa120\sl-240\slmult0\widctlpar\tx300{\*\pn \pnlvlblt\ilvl0\ls75\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls75\adjustright {
Speech recognition sharing object 
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {I
f your application does not require detailed control of speech recognition, you can use voice-command objects to implement command and control. Voice commands use speech recognition objects, so they also serve as an example of implementing speech recognit
ion.
\par }\pard\plain \s81\li360\ri360\sb100\sa100\nowidctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright {\b\cf1 For more information}{\cf1 \~\~\~about voice commands, see the Voice Command API Reference.
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {\page }{\cs80\v\cf6 <!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">}{\fs28 DirectSpeechRecognition API }{
\par }\pard\plain \s1\li-360\sb120\sa120\sl-560\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel0\adjustright \fs52\kerning28\cgrid {\cf1 Engine COM Object}{
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Represents a speech recognition mode of an engine, which processes and recog
nizes incoming speech. An engine typically provides an assortment of speech recognition modes that can be used to recognize speech in different languages, dialects, or audio sampling rates. The engine object is supplied by the engine vendor.
\par }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \fs40\kerning28\cgrid {\cf1 {\*\bkmkstart Created_by}Created by}{{\*\bkmkend Created_by}
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {To create an engine object, you first use a speech recognition enumerator to locate the mode to use, and then call the }{\b ISREnum}{
::Select member function with the GUID of the mode and the address of the }{\b IUnknown}{ interface of an audio-source object. 
\par As the engine object initializes, it calls the }{\b IAudio}{ interface on the audio-source object to determine whether or not it can use that audio source. If so, the engine object calls the }{\b IAudio}{::PassNotify member function with an }{\b 
IAudioSourceNotifySink}{ notification inter
face so the audio-source object can notify the engine of events that pertain to incoming audio. If the engine cannot use the specified audio source, the Select member function returns an error and the engine object releases itself.
\par If successful, the Select member function returns the address of the }{\b ISRCentral}{ interface on the newly created engine object.
\par }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \fs40\kerning28\cgrid {\cf1 {\*\bkmkstart Interacts_with}Interacts with}{{\*\bkmkend Interacts_with}
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {
The engine object uses the rules, lists of words, or context provided by all active grammar objects to parse incoming speech and recognize it.
\par The engine object receives notifications from the audio-source object about the status of incoming audio, such as whether audio data is available.
\par The engine object can notify the application of events that pertain to speech recognition, such as interference in the audio signal or the beginning and end of an utterance. To receive notifications, the application calls the }{\b ISRCentral}{
::Register member function on the engine object and passes the address of the notification interface. The application must create a COM object that supports }{\b ISRNotifySink}{
 as an interface. How the application responds to notifications is up to the application developer.
\par }\pard\plain \s2\li-360\sb120\sa120\sl-440\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \fs40\kerning28\cgrid {\cf1 {\*\bkmkstart Interfaces}Interfaces}{{\*\bkmkend Interfaces}
\par }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The engine object should support the }{\b ISRAttributes}{, }{\b ISRCentral}{, and }{\b ISRDialogs}{ interfaces, and it ma
y also support the }{\b ILexPronounce}{ and }{\b ISRSpeaker}{ interfaces. An engine object may support other interfaces defined by the engine vendor to provide additional functionality.
\par }\trowd \trbrdrt\brdrs\brdrw30\brdrcf11 \trbrdrb\brdrs\brdrw30\brdrcf11 \clvertalt\clbrdrt\brdrs\brdrw30\brdrcf11 \clbrdrb\brdrs\brdrw15\brdrcf11 \cltxlrtb \cellx1284\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf11 \clbrdrb\brdrs\brdrw15\brdrcf11 \cltxlrtb 
