\par BOOL BeginOLE()
\par \{
\par     HRESULT  hRes;
\par 
\par     // Initialize OLE.
\par     if (FAILED(CoInitialize(NULL)))
\par         return ReleaseInterfaces("CoInitialize() failed.");
\par 
\par     // Create a Voice Text object.
\par     if (CoCreateInstance(CLSID_VTxt, NULL, CLSCTX_LOCAL_SERVER,
\par             IID_IVoiceText, (LPVOID *) &gpIVTxt) != S_OK)
\par         return ReleaseInterfaces(
\par             "Error in CoCreateInstance for Voice Text interface." );
\par 
\par     // Get the address of the Voice Text attributes interface.
\par     hRes = gpIVTxt-QueryInterface(IID_IVTxtAttributes,
\par         (LPVOID FAR *) &gpIVTxtAttr);
\par     if (FAILED(hRes))
\par         return ReleaseInterfaces(
\par             "Failed to get Voice Text attributes interface.");
\par 
\par     // Create and register the Voice Text notification sink.
\par     gpVTxtNotifySink = new CIVTxtNotifySink;
\par     if (gpVTxtNotifySink == NULL)
\par         return ReleaseInterfaces(
\par             "Out of memory for Voice Text notification object.");
\par 
\par     hRes = gpIVTxt-Register(NULL, "SRClock", gpVTxtNotifySink,
\par          IID_IVTxtNotifySink, VTXTF_ALLMESSAGES, NULL);
\par     if (FAILED(hRes))
\par         return ReleaseInterfaces(
\par             "Failed to register Voice Text notification sink.");
\par 
\par     return TRUE;
\par \}\cell }\pard\plain \widctlpar\intbl{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cf14\cgrid {\cs82\f2\cf0 \row }\pard\plain \s16\sa120\sl-240\slmult0\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The }{\b 
