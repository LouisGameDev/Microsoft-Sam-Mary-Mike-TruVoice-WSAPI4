\adjustright \fs20\cf14\cgrid {\cf0 \row }\trowd \trbrdrt\brdrs\brdrw30\brdrcf11 \trbrdrb\brdrs\brdrw30\brdrcf11 \clvertalt\clbrdrb\brdrs\brdrw30\brdrcf11 \cltxlrtb \cellx2729\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf11 \cltxlrtb \cellx7320\pard\plain 
